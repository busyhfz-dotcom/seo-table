generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectorProvider {
  WORDPRESS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS
  YOUTUBE
  INSTAGRAM
}

enum ConnectorStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
}

enum AuditStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum IssueSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IGNORED
  FIX_PLANNED
  RESOLVED
}

enum FixRisk {
  SAFE
  REVIEW_REQUIRED
  BLOCKED
}

enum FixStatus {
  PLANNED
  AWAITING_APPROVAL
  APPROVED
  APPLYING
  APPLIED
  FAILED
  REVERTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MetricSource {
  CRAWLER
  SEARCH_CONSOLE
  GA4
  YOUTUBE
  INSTAGRAM
}

enum ContentChannel {
  WEBSITE
  INSTAGRAM
  YOUTUBE
}

enum OpportunityStatus {
  NEW
  PLANNED
  DRAFTING
  READY
  PUBLISHED
  DISMISSED
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  createdAt         DateTime             @default(now())
  memberships       OrganizationMember[]
  approvalsReviewed Approval[]           @relation("ApprovalReviewer")
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  members   OrganizationMember[]
  projects  Project[]
  createdAt DateTime             @default(now())
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("MEMBER")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id                   String               @id @default(uuid())
  name                 String
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websites             Website[]
  socialAccounts       SocialAccount[]
  connectors           Connector[]
  approvals            Approval[]
  metricSnapshots      MetricSnapshot[]
  contentOpportunities ContentOpportunity[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Website {
  id                   String               @id @default(uuid())
  domain               String
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages                Page[]
  opportunities        SeoOpportunity[]
  scans                Scan[]
  recommendations      Recommendation[]
  auditRuns            AuditRun[]
  issues               SeoIssue[]
  fixes                SeoFix[]
  metricSnapshots      MetricSnapshot[]
  contentOpportunities ContentOpportunity[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([projectId, domain])
}

model Page {
  id              String         @id @default(uuid())
  url             String
  websiteId       String
  website         Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  title           String?
  metaDescription String?
  canonicalUrl    String?
  h1              String?
  lastStatusCode  Int?
  lastCrawledAt   DateTime?
  issues          SeoIssue[]
  snapshots       PageSnapshot[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([websiteId, url])
  @@index([websiteId, lastCrawledAt])
}

model Connector {
  id                String            @id @default(uuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider          ConnectorProvider
  status            ConnectorStatus   @default(DISCONNECTED)
  externalAccountId String?
  displayName       String?
  credentialRef     String?
  config            Json?
  lastSyncedAt      DateTime?
  socialAccounts    SocialAccount[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId, provider, status])
}

model SocialAccount {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectorId String?
  connector   Connector?     @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  platform    SocialPlatform
  handle      String
  profileUrl  String
  externalId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([projectId, platform, handle])
}

model AuditRun {
  id              String      @id @default(uuid())
  websiteId       String
  website         Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  status          AuditStatus @default(QUEUED)
  source          String      @default("CRAWLER")
  score           Int?
  pagesDiscovered Int         @default(0)
  pagesScanned    Int         @default(0)
  robotsStatus    String?
  sitemapStatus   String?
  error           String?
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  issues          SeoIssue[]
  snapshots       PageSnapshot[]

  @@index([websiteId, startedAt])
}

model PageSnapshot {
  id                String   @id @default(uuid())
  pageId            String
  page              Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  auditRunId        String
  auditRun          AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  statusCode        Int
  title             String?
  metaDescription   String?
  canonicalUrl      String?
  h1Count           Int      @default(0)
  missingAltCount   Int      @default(0)
  internalLinkCount Int      @default(0)
  noindex           Boolean  @default(false)
  fetchedAt         DateTime @default(now())

  @@unique([pageId, auditRunId])
}

model SeoIssue {
  id                  String        @id @default(uuid())
  websiteId           String
  website             Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pageId              String?
  page                Page?         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  auditRunId          String?
  auditRun            AuditRun?     @relation(fields: [auditRunId], references: [id], onDelete: SetNull)
  code                String
  severity            IssueSeverity
  status              IssueStatus   @default(OPEN)
  title               String
  details             String
  evidence            Json?
  fingerprint         String
  suggestedActionType String?
  fixes               SeoFix[]
  firstSeenAt         DateTime      @default(now())
  lastSeenAt          DateTime      @default(now())
  resolvedAt          DateTime?

  @@index([websiteId, status, severity])
  @@index([fingerprint])
}

model SeoFix {
  id         String    @id @default(uuid())
  websiteId  String
  website    Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  issueId    String?
  issue      SeoIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  actionType String
  risk       FixRisk
  status     FixStatus @default(PLANNED)
  payload    Json
  result     Json?
  error      String?
  approvals  Approval[]
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  appliedAt  DateTime?
  revertedAt DateTime?

  @@index([websiteId, status, risk])
}

model Approval {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fixId       String         @unique
  fix         SeoFix         @relation(fields: [fixId], references: [id], onDelete: Cascade)
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  reviewerId  String?
  reviewer    User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  note        String?

  @@index([projectId, status, requestedAt])
}

model MetricSnapshot {
  id         String       @id @default(uuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  websiteId  String?
  website    Website?     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  source     MetricSource
  metric     String
  value      Float
  dimensions Json?
  recordedAt DateTime     @default(now())

  @@index([projectId, source, metric, recordedAt])
  @@index([websiteId, metric, recordedAt])
}

model ContentOpportunity {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  websiteId   String?
  website     Website?          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  channel     ContentChannel
  status      OpportunityStatus @default(NEW)
  title       String
  rationale   String
  targetQuery String?
  priority    Int               @default(50)
  confidence  Float?
  brief       Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId, channel, status, priority])
}

// Legacy v0.1 entities kept during the v0.3 migration window.
model SeoOpportunity {
  id        String  @id @default(uuid())
  type      String
  priority  Int
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Scan {
  id        String   @id @default(uuid())
  status    String
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Recommendation {
  id        String   @id @default(uuid())
  title     String
  status    String   @default("PENDING")
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
